<section class="pm-construction-section" id="construction">
  <div class="pawmedal-wrap">
    <div class="pm-construction-header">
      <span class="pm-pill-badge dark">Precision Craftsmanship</span>
      <h2>The PawMedal Tag.<br>Built for a lifetime of adventure.</h2>
      <p class="subhead">
        Every PawMedal is engineered with the same precision as aerospace instruments.<br>Combining artisan jewelry aesthetics with military-grade resilience, it handles rigorous outdoor play with ease.
      </p>
    </div>

    <div class="pm-construction-grid">
      <div class="pm-exploded-view-card">
        <img src="{{ '02-exploded-view-1200.png' | asset_url }}" alt="PawMedal Tag 3D Exploded Engineering View" class="pm-exploded-img" width="1200" height="1200" loading="lazy">
      </div>

      <div class="pm-construction-details">

      <div class="pm-layers-list">
        <div class="pm-layer-item">
          <div class="pm-layer-number">1</div>
          <div class="pm-layer-text">
            <h4>Custom UV-Cured Art Face &amp; Plexi Shield</h4>
            <p>Vibrant archival pigments sealed beneath crystal-clear, scratch-proof acrylic.</p>
          </div>
        </div>

        <div class="pm-layer-item">
          <div class="pm-layer-number">2</div>
          <div class="pm-layer-text">
            <h4>Sealed Passive NFC Chip &amp; Dynamic QR Matrix</h4>
            <p>Completely passive RFID architecture — requires no charging, functioning indefinitely.</p>
          </div>
        </div>

        <div class="pm-layer-item">
          <div class="pm-layer-number">3</div>
          <div class="pm-layer-text">
            <h4>CNC-Milled Aerospace Aluminum Core</h4>
            <p>Ultra-dense anodized alloy frame that resists heavy biting, drops, and abrasions.</p>
          </div>
        </div>

        <div class="pm-layer-item">
          <div class="pm-layer-number">4</div>
          <div class="pm-layer-text">
            <h4>Ergonomic Reinforced Attachment Eyelet</h4>
            <p>Curved chamfered ring loop that securely anchors to all collar widths and harnesses.</p>
          </div>
        </div>
      </div>

      <a href="#design-studio" class="pm-btn pm-btn-gold">
        Design Your Custom Tag
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</div>
</section>

{% schema %}
{
  "name": "PawMedal Construction V2",
  "settings": [],
  "presets": [
    {
      "name": "PawMedal Construction V2"
    }
  ]
}
{% endschema %}
