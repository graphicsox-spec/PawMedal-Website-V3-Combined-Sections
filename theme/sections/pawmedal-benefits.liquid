<section class="pm-benefits-section" id="pawmedal-benefits">
  <div class="pawmedal-wrap">
    <div class="pm-benefits-grid">
      <div class="pm-benefit-card">
        <div class="pm-benefit-icon-box">
          <i class="fa-brands fa-apple"></i>
        </div>
        <div class="pm-benefit-text">
          <h3>Works with Apple</h3>
          <p>Global Find My device network</p>
        </div>
      </div>

      <div class="pm-benefit-card">
        <div class="pm-benefit-icon-box">
          <img src="{{ 'nfc-scan-icon.svg' | asset_url }}" alt="NFC Scan" class="pm-benefit-svg-icon" width="20" height="25">
        </div>
        <div class="pm-benefit-text">
          <h3>NFC &amp; QR Tap</h3>
          <p>Instant scan, zero app needed</p>
        </div>
      </div>

      <div class="pm-benefit-card">
        <div class="pm-benefit-icon-box">
          <img src="{{ 'paw-footprint.svg' | asset_url }}" alt="Paw Footprint" class="pm-benefit-svg-icon" width="24" height="23">
        </div>
        <div class="pm-benefit-text">
          <h3>Unique Pet Profile</h3>
          <p>Medical, vaccine &amp; owner contacts</p>
        </div>
      </div>

      <div class="pm-benefit-card">
        <div class="pm-benefit-icon-box">
          <img src="{{ 'Waterproof_icon.svg' | asset_url }}" alt="Waterproof" class="pm-waterproof-svg-icon" width="22" height="28">
        </div>
        <div class="pm-benefit-text">
          <h3>Light &amp; Waterproof</h3>
          <p>IP68 submersible aviation build</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PawMedal Benefits V2",
  "settings": [],
  "presets": [
    {
      "name": "PawMedal Benefits V2"
    }
  ]
}
{% endschema %}
