<section class="pm-cloud-banner" id="how-it-works">
  <div class="pm-cloud-wrap">
    <div class="pm-cloud-content">
      <span class="pm-cloud-pill"><i class="fa-solid" aria-hidden="true">&#xf0c2;</i> CLOUD PET PROFILE</span>
      <h2>More than <span>just an ID</span></h2>
      <p class="pm-cloud-lead">
        Give your pet a secure digital profile. One tap opens their details instantly on any smartphone, with no app required.
      </p>

      <div class="pm-cloud-features">
        <div class="pm-cloud-feature">
          <div class="pm-cloud-icon">
            <i class="fa-solid fa-phone"></i>
          </div>
          <div class="pm-cloud-info">
            <h4>1-Tap Emergency Contact</h4>
            <p>Call, WhatsApp &amp; backup contacts.</p>
          </div>
        </div>

        <div class="pm-cloud-feature">
          <div class="pm-cloud-icon">
            <i class="fa-solid fa-notes-medical"></i>
          </div>
          <div class="pm-cloud-info">
            <h4>Medical &amp; Vaccine Records</h4>
            <p>Allergies, microchip ID &amp; vet details.</p>
          </div>
        </div>

        <div class="pm-cloud-feature">
          <div class="pm-cloud-icon">
            <i class="fa-solid fa-bell"></i>
          </div>
          <div class="pm-cloud-info">
            <h4>Active Lost Mode</h4>
            <p>Alerts finders with reward &amp; return info.</p>
          </div>
        </div>

        <div class="pm-cloud-feature">
          <div class="pm-cloud-icon">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div class="pm-cloud-info">
            <h4>Instant Scan GPS Location</h4>
            <p>Instant map pin when scanned.</p>
          </div>
        </div>
      </div>

      <div class="pm-cloud-action"><a href="#design-studio" class="pm-cloud-cta">
        Create Your Pet's Profile
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a><span class="pm-cloud-hand" aria-hidden="true">Because they’re<br>family. ♡</span></div>
</div>
</section>

{% schema %}
{
  "name": "PawMedal Profile V2",
  "settings": [],
  "presets": [
    {
      "name": "PawMedal Profile V2"
    }
  ]
}
{% endschema %}
