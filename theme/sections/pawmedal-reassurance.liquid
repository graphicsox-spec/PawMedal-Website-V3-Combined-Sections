<section class="pm-reassurance-section" id="reassurance">
  <div class="pawmedal-wrap">
    <div class="pm-reassurance-card">
      <div class="pm-reassurance-media">
        <img src="{{ 'Built Out Of Love.png' | asset_url }}" alt="Dog and cat together - Built Out Of Love" width="600" height="600" loading="lazy">
      </div>

      <div class="pm-reassurance-text">
        <span class="pm-pill-badge">Built Out Of Love</span>
        <h2 style="margin-top: 14px;">Because they're more than just pets. They're family.</h2>
        <div class="pm-warm-quote">“Same love. More adventures together.”</div>
