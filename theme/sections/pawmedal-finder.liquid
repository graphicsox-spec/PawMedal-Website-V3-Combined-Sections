<section class="pm-finder-spotlight-section" id="finder-spotlight">
  <div class="pawmedal-wrap pm-finder-grid">
    <div class="pm-finder-content">
      <span class="pm-pill-badge dark">Apple Find My Technology</span>
      <h2 style="margin-top: 14px;">PawMedal Finder. Track what matters. No limits.</h2>
      <p class="subhead">
        Harnessing the immense security of Apple's global Find My network. When your dog or cat roams out of sight, millions of Apple devices worldwide silently collaborate to pinpoint your pet's precise location on your map.
      </p>

      <div class="pm-finder-features-grid">
        <div class="pm-finder-f-box">
          <div class="icon"><i class="fa-brands fa-apple"></i></div>
          <h4>Apple Find My Certified</h4>
          <p>Pairs natively with your iPhone, iPad, or Mac in under 30 seconds.</p>
        </div>

        <div class="pm-finder-f-box">
          <div class="icon"><i class="fa-solid fa-ban"></i></div>
          <h4>Zero Monthly Subscriptions</h4>
          <p>No monthly SIM charges, no annual contracts, no hidden recurring fees.</p>
        </div>

        <div class="pm-finder-f-box">
          <div class="icon"><i class="fa-solid fa-battery-full"></i></div>
          <h4>1-Year Replaceable Battery</h4>
          <p>Powered by standard user-replaceable CR2032 coin battery.</p>
        </div>

        <div class="pm-finder-f-box">
          <div class="icon"><i class="fa-solid fa-shield-halved"></i></div>
          <h4>IP68 Submersible Build</h4>
          <p>Engineered for torrential rain, river swims, and muddy trails.</p>
        </div>
      </div>

      <div class="pm-finder-actions">
        <a href="#shop" class="pm-btn pm-btn-gold">
          Order PawMedal Finder (€79.90)
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#construction" class="pm-btn pm-btn-outline-dark">
          Explore Engineering
        </a>
      </div>
    </div>

    <!-- Visual Column -->
    <div class="pm-finder-visual-col">
      <div class="pm-finder-stage">
        <div class="pm-finder-radar-bg">
          <span class="pm-radar-wave pm-wave-1"></span>
          <span class="pm-radar-wave pm-wave-2"></span>
          <span class="pm-radar-wave pm-wave-3"></span>
        </div>
        <img src="{{ 'pawmedal-finder-beach.png' | asset_url }}" alt="PawMedal Finder Hardware" class="pm-finder-large-img" width="500" height="500" loading="eager">
      </div>
      
      <div class="pm-finder-map-pill">
        <span class="dot"></span>
        <span>Find My Network Active · Signal 100%</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PawMedal Finder V2",
  "settings": [],
  "presets": [
    {
      "name": "PawMedal Finder V2"
    }
  ]
}
{% endschema %}
