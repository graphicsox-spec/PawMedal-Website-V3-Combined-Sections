<section class="pm-comparison-section" id="comparison">
  <div class="pawmedal-wrap">
    <div class="pm-section-header pm-comparison-header">
      <span class="pm-pill-badge">Direct Comparison</span>
      <h2>Why choose PawMedal?<br>A clear difference.</h2>
      <p>See why thousands of pet parents have replaced ordinary engraved metal tags with PawMedal.</p>
    </div>

    <div class="pm-comparison-card">
      <table class="pm-comp-table">
        <thead>
          <tr>
            <th>Security &amp; Safety Features</th>
            <th>
              <img src="{{ '05-PawMedalTag-1200.png' | asset_url }}" alt="Traditional Tag" class="pm-comp-thumb">
              <div>Traditional Tag</div>
            </th>
            <th class="highlight-col">
              <img src="{{ '01-pawtag2-1200.png' | asset_url }}" alt="PawMedal Tag" class="pm-comp-thumb">
              <div>PawMedal Tag</div>
            </th>
            <th>
              <img src="{{ '04-PawMedalFinder-1200.png' | asset_url }}" alt="PawMedal Finder" class="pm-comp-thumb">
              <div>PawMedal Finder</div>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Detailed Owner Contact Info</td>
            <td><span class="pm-comp-check">✓</span></td>
            <td class="highlight-col"><span class="pm-comp-check">✓</span></td>
            <td><span class="pm-comp-check">✓</span></td>
          </tr>
          <tr>
            <td>Instant NFC Tap &amp; Dynamic QR Scan</td>
            <td><span class="pm-comp-cross">✕</span></td>
            <td class="highlight-col"><span class="pm-comp-check">✓</span></td>
            <td><span class="pm-comp-check">✓</span></td>
          </tr>
          <tr>
            <td>Updateable Profile (Change phone/address anytime)</td>
            <td><span class="pm-comp-cross">✕</span></td>
            <td class="highlight-col"><span class="pm-comp-check">✓</span></td>
            <td><span class="pm-comp-check">✓</span></td>
          </tr>
          <tr>
            <td>Emergency Medical &amp; Vaccination Records</td>
            <td><span class="pm-comp-cross">✕</span></td>
            <td class="highlight-col"><span class="pm-comp-check">✓</span></td>
            <td><span class="pm-comp-check">✓</span></td>
          </tr>
          <tr>
            <td>Apple Find My Global Device Network</td>
            <td><span class="pm-comp-cross">✕</span></td>
            <td class="highlight-col"><span class="pm-comp-cross">✕</span></td>
            <td><span class="pm-comp-check">✓</span></td>
          </tr>
          <tr>
            <td>Instant GPS Scan Notification to Owner</td>
            <td><span class="pm-comp-cross">✕</span></td>
            <td class="highlight-col"><span class="pm-comp-check">✓</span></td>
            <td><span class="pm-comp-check">✓</span></td>
          </tr>
          <tr>
            <td>Zero Monthly Subscription Fees</td>
            <td><span class="pm-comp-check">✓</span></td>
            <td class="highlight-col"><span class="pm-comp-check">✓</span></td>
            <td><span class="pm-comp-check">✓</span></td>
          </tr>
          <tr>
            <td>Submersible Waterproof &amp; Aviation Aluminum Core</td>
            <td><span class="pm-comp-cross">✕</span></td>
            <td class="highlight-col"><span class="pm-comp-check">✓</span></td>
            <td><span class="pm-comp-check">✓</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

