<section class="pm-chooser-section" id="shop">
  <div class="pawmedal-wrap">
    <div class="pm-section-header">
      <span class="pm-pill-badge">Precision Protection</span>
      <h2 style="margin-top: 12px;">Choose your PawMedal</h2>
      <p>Select the smart security solution tailored to your companion's daily lifestyle.</p>
    </div>

    <div class="pm-products-grid">
      <!-- Product 1: PawMedal Tag -->
      <article class="pm-product-card">
        <div class="pm-card-top">
          <h3>PawMedal Tag</h3>
          <div class="pm-card-subline">PERSONALIZED. STYLISH. SAFE.</div>
        </div>

        <div class="pm-card-media pm-card-media-tag">
          <img src="{{ '01-pawtag2-1200.png' | asset_url }}" alt="PawMedal Tag personalized" width="400" height="400" loading="lazy">
        </div>

        <ul class="pm-card-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Personalized custom artwork
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Instant NFC &amp; Dynamic QR
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Lightweight &amp; waterproof durability
          </li>
        </ul>

        <div class="pm-card-bottom">
          <div class="pm-card-price-row">
            <span class="price">€49.90</span>
            <span class="subtext">One-time payment</span>
          </div>
          <a href="#design-studio" class="pm-btn pm-btn-secondary">
            Design My Tag
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </article>

      <!-- Product 2: PawMedal Finder -->
      <article class="pm-product-card">
        <div class="pm-card-top">
          <h3>PawMedal Finder</h3>
          <div class="pm-card-subline">TRACK. FIND. REUNITE.</div>
        </div>

        <div class="pm-card-media">
          <img src="{{ '04-PawMedalFinder-1200.png' | asset_url }}" alt="PawMedal Finder" width="400" height="400" loading="lazy">
        </div>

        <ul class="pm-card-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Works with Apple Find My Network
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Up to 1 year replaceable battery
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            IP68 Submersible waterproof
          </li>
        </ul>

        <div class="pm-card-bottom">
          <div class="pm-card-price-row">
            <span class="price">€79.90</span>
            <span class="subtext">Zero subscription fees</span>
          </div>
          <a href="#finder-spotlight" class="pm-btn pm-btn-primary">
            Explore Finder
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </article>

      <!-- Product 3: PawMedal Bundle (Featured) -->
      <article class="pm-product-card featured">
        <div class="pm-card-badge">COMPLETE DEFENSE<br>BEST VALUE</div>

        <div class="pm-card-top">
          <h3>PawMedal Bundle</h3>
          <div class="pm-card-subline">THE ULTIMATE PROTECTION</div>
        </div>

        <div class="pm-card-media pm-card-media-bundle">
          <img src="{{ '01-pawtag2-1200.png' | asset_url }}" alt="PawMedal Tag" class="pm-bundle-img pm-bundle-tag" loading="lazy">
          <img src="{{ '04-PawMedalFinder-1200.png' | asset_url }}" alt="PawMedal Finder" class="pm-bundle-img pm-bundle-finder" loading="lazy">
        </div>

        <ul class="pm-card-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Includes Personalized Tag + Smart Finder
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Apple Find My tracking + Instant NFC Profile
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Maximum safety &amp; full coverage for adventures
          </li>
        </ul>

        <div class="pm-card-bottom">
          <div class="pm-card-price-row">
            <span class="price">€99.90</span>
            <span class="subtext" style="color: #27AE60; font-weight: 700;">Save €29.90</span>
          </div>
          <a href="#design-studio" class="pm-btn pm-btn-gold">
            Get The Bundle
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

