<section class="pm-hero-section pm-hero-fullbleed" id="pawmedal-hero">
  <!-- Full-Bleed 1920x900 Panoramic Background Image -->
  <div class="pm-hero-bg-media">
    <img 
      src="{{ 'pawmedal-hero-dog-tagged.jpg' | asset_url }}" 
      alt="Dog wearing PawMedal Tag in nature" 
      class="pm-hero-bg-img" 
      width="1920" 
      height="900" 
      loading="eager"
    >
  </div>

  <!-- Hero Content Layer -->
  <div class="pawmedal-wrap pm-hero-container">
    <div class="pm-hero-grid">
      <!-- Left: Text Information -->
      <div class="pm-hero-content">
        <div class="pm-hero-eyebrow">
          <span class="pm-pill-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {{ section.settings.eyebrow | default: "Love Them. Keep Them Close." }}
          </span>
        </div>

        <h1 class="pm-hero-title">
          Personalized<br>
          smart tags<br>
          <span class="highlight-gold">for your pet.</span>
        </h1>

        <p class="pm-hero-lead">
          A smarter way to keep your pet safe. With Apple Find My,<br>
          NFC and a unique digital pet profile, PawMedal helps you find,<br>
          protect, and care for what matters most.
        </p>

        <div class="pm-hero-actions">
          <a href="#design-studio" class="pm-btn pm-btn-gold">
            {{ section.settings.button_label | default: "Design My Tag" }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#how-it-works" class="pm-btn pm-btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            Watch Story
          </a>
        </div>
      </div>

      <!-- Right: Spacer for grid layout -->
      <div class="pm-hero-dog-stage" aria-hidden="true"></div>
    </div>
  </div>

  <!-- 4 Floating Badges around the Dog & Centered Medal Beacon (Pinned cleanly to hero coordinates) -->
  <div class="pm-hero-floating-layer">
    <!-- Tag 1: Works with Apple (Top Right, in forest background) -->
    <div class="pm-floating-chip pm-chip-apple">
      <div class="pm-chip-icon">
        <i class="fa-brands fa-apple"></i>
      </div>
      <div class="pm-chip-title">Works with<br>Apple</div>
    </div>

    <!-- Tag 2: Unique Pet Profile (Top Left, in open mountain sky) -->
    <div class="pm-floating-chip pm-chip-profile">
      <div class="pm-chip-icon">
        <svg class="pm-paw-icon" width="20" height="20" viewBox="0 0 90 88" fill="currentColor">
          <circle cx="19" cy="29" r="9"/>
          <circle cx="35.5" cy="14.5" r="9.5"/>
          <circle cx="56.5" cy="14.5" r="9.5"/>
          <circle cx="73" cy="29" r="9"/>
          <path d="M46 36 C52 36 56 42 61 50 C66 58 75 58 75 64 C75 70 68 76 60 76 C53 76 49 71 46 71 C43 71 39 76 32 76 C24 76 17 70 17 64 C17 58 26 58 31 50 C36 42 40 36 46 36 Z"/>
        </svg>
      </div>
      <div class="pm-chip-title">Unique<br>Pet Profile</div>
    </div>

    <!-- Tag 3: NFC & QR Tap (Mid Left, in open meadow background) -->
    <div class="pm-floating-chip pm-chip-nfc">
      <div class="pm-chip-icon">
        <i class="fa-solid fa-qrcode"></i>
      </div>
      <div class="pm-chip-title">NFC &amp;<br>QR Tap</div>
    </div>

    <!-- Tag 4: Light & Waterproof (Mid Right, in pine forest background) -->
    <div class="pm-floating-chip pm-chip-waterproof">
      <div class="pm-chip-icon">
        <img src="{{ 'Waterproof_icon.svg' | asset_url }}" alt="Waterproof" class="pm-waterproof-svg-chip" width="18" height="23">
      </div>
      <div class="pm-chip-title">Light &amp;<br>Waterproof</div>
    </div>

    <!-- Live Collar Beacon: Exactly below the circular medal and centered -->
    <div class="pm-hero-collar-beacon">
      <div class="pm-beacon-badge">
        <span class="dot"></span>
        <span>PawMedal Active</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PawMedal Hero V2",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LOVE THEM. KEEP THEM CLOSE."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Personalized smart tag for your pet."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "A smarter way to keep your pet safe. With Apple Find My,\nNFC and a unique digital pet profile, PawMedal helps you find,\nprotect, and care for what matters most."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Design My Tag"
    }
  ],
  "presets": [
    {
      "name": "PawMedal Hero V2"
    }
  ]
}
{% endschema %}
