<section class="pm-stats-section" id="reconnection">
  <div class="pawmedal-wrap pm-stats-grid">
    <div class="pm-stats-narrative">
      <span class="pm-pill-badge">Why It Matters</span>
      <h2 style="margin-top: 14px;">Every year, millions of pets go missing.</h2>
      <p>
        A lost pet can happen in seconds — a garden gate left ajar, an unexpected thunderstorm, or a sudden sprint in the park. 
        Traditional engraved tags scratch, fade, and hold only a static number. PawMedal gives you a proactive, connected lifeline to dramatically increase the chances of a safe, rapid reunion.
      </p>
    </div>

    <div class="pm-stats-cards-col">
      <div class="pm-stat-box">
        <div class="pm-stat-paw-badge">
          <img src="{{ 'PawFootPrint.svg' | asset_url }}" alt="Paw Footprint" width="56" height="56">
        </div>
        <div class="pm-stat-icon">
          <i class="fa-solid fa-compass"></i>
        </div>
        <div class="pm-stat-number">10M+</div>
        <div class="pm-stat-label">Pets go missing across Europe every single year.</div>
      </div>

      <div class="pm-stat-box">
        <div class="pm-stat-paw-badge is-inverted">
          <img src="{{ 'PawFootPrint.svg' | asset_url }}" alt="Paw Footprint" width="56" height="56">
        </div>
        <div class="pm-stat-icon">
          <i class="fa-solid fa-house-chimney-crack"></i>
        </div>
        <div class="pm-stat-number">8M+</div>
        <div class="pm-stat-label">Are tragically never reunited due to outdated identification.</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PawMedal Statistics V2",
  "settings": [],
  "presets": [
    {
      "name": "PawMedal Statistics V2"
    }
  ]
}
{% endschema %}
