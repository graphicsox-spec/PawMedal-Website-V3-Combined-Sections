<section class="pm-stats-section" id="reconnection">
  <div class="pawmedal-wrap pm-stats-grid">
    <div class="pm-stats-narrative">
      <span class="pm-pill-badge">Why It Matters</span>
      <h2 style="margin-top: 14px;">Every year<br>millions of pets<br><span class="pm-stats-gold">go missing.</span></h2>
      <p>
        A lost pet can happen in seconds. Traditional tags fade,<br>
        scratch, and store limited information. PawMedal gives<br>
        your pet a smarter, connected identity for a faster<br>
        and safer reunion.
      </p>
      <div class="pm-stats-promise">
        <span><strong>Smarter ID. Faster reunions.</strong></span>
        <span class="pm-stats-promise-arrow"><i class="fa-solid fa-arrow-right"></i></span>
      </div>
    </div>

    <div class="pm-stats-cards-col">
      <div class="pm-stat-box">
        <div class="pm-stat-paw-badge"><i class="fa-solid fa-paw" aria-hidden="true"></i></div>
        <div class="pm-stat-icon">
          <i class="fa-solid fa-compass"></i>
        </div>
        <div class="pm-stat-number">10M+</div>
        <div class="pm-stat-label">Pets go missing across Europe every single year.</div>
      </div>

      <div class="pm-stat-box">
        <div class="pm-stat-paw-badge is-inverted"><i class="fa-solid fa-paw" aria-hidden="true"></i></div>
        <div class="pm-stat-icon">
          <i class="fa-solid fa-house-chimney-crack"></i>
        </div>
        <div class="pm-stat-number">8M+</div>
        <div class="pm-stat-label">Are tragically never reunited due to outdated identification.</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PawMedal Statistics V2",
  "settings": [],
  "presets": [
    {
      "name": "PawMedal Statistics V2"
    }
  ]
}
{% endschema %}
